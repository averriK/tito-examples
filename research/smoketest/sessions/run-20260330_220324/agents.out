},\n  urldate = {2026-03-30},\n}\n\n@online{MaterialPropertiesCopper,\n  title = {Copper: Mechanical Properties, Strength, Hardness, Crystal Structure},\n  url = {https://material-properties.org/copper-mechanical-properties-strength-hardness-crystal-structure/},\n  urldate = {2026-03-30},\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":9645,"cache_read_input_tokens":53423,"cache_creation":{"ephemeral_5m_input_tokens":9645,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"cb9ae42e-e1d3-4ee7-b51f-914c838e3680","uuid":"bd144ac9-c71d-455c-b639-7ed135178dad"}
