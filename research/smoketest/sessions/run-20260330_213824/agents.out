:"{\n  \"schema_version\": 1,\n  \"task_file\": \"/home/averri/github/tools/tito-examples/research/smoketest/md/task.prompt.md\",\n  \"slot_count\": 3,\n  \"constraint_count\": 2,\n  \"slots\": [\n    {\"ordinal\": 1, \"title\": \"Metals ranked by melting point\", \"instruction\": \"All metals referenced in the KB are ranked by melting point from highest to lowest. Content is presented as a sorted list.\"},\n    {\"ordinal\": 2, \"title\": \"Highest-density metal and structural relevance\", \"instruction\": \"The metal with the highest density among those in the KB is identified, accompanied by a brief explanation of why high density is significant for structural applications. Content is presented in flowing paragraphs.\"},\n    {\"ordinal\": 3, \"title\": \"Iron versus aluminum comparison\", \"instruction\": \"The key differences between iron and aluminum are summarized as a short comparison, drawing on data available in the KB. Content is presented as a concise comparison.\"}\n  ],\n  \"constraints\": [\n    \"Output language: English.\",\n    \"All data and claims derive from the KB provided.\"\n  ]\n}\n","numLines":16,"startLine":1,"totalLines":16}}}
