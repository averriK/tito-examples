@techreport{LouvicourtPSHA2024,
  title = {{Probabilistic Seismic Hazard Assessment for Louvicourt Tailings Storage Facility}},
  author = {{Technical Report}},
  year = {2024},
  institution = {Technical Engineering Consultancy},
  address = {Southeastern Canada},
  note = {PSHA report analyzing seismic hazard for the Louvicourt TSF site (48.135°N, 77.595°W) using CanadaSHM6 source model, NGA-East ground motion models, and site-specific conditions with Vs30 of 1,853 m/s. Includes hazard calculations for multiple return periods (1/2,475, 1/5,000, 1/10,000 years), disaggregation analysis, ground motion selection using PEER NGA-West2 database with spectral matching, and comparison with 2020 NBCC values. Analysis performed using OpenQuake 3.16.3}
}
